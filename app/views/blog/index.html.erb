<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
  <nav class="border-b border-white/10 bg-white/5 backdrop-blur-md">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <%= link_to root_path, class: "flex items-center" do %>
          <span class="text-xl font-bold text-white">Pedro Dalben</span>
        <% end %>
        <div class="flex items-center gap-6">
          <%= link_to "Portfólio", root_path, class: "text-gray-300 hover:text-white transition-colors" %>
          <%= link_to "Blog", blog_path, class: "text-white font-medium" %>
        </div>
      </div>
    </div>
  </nav>

  <main class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold text-white mb-4">Blog</h1>
      <div class="h-1 w-24 bg-gradient-to-r from-purple-500 to-pink-500 mx-auto"></div>
      <p class="text-gray-300 mt-6 text-lg">Artigos sobre desenvolvimento, tecnologia e carreira</p>
    </div>

    <div class="space-y-6">
      <% @posts.each do |post| %>
        <article class="rounded-xl bg-white/10 backdrop-blur-md border border-white/20 hover:border-purple-500/50 transition-all">
          <div class="p-6">
            <h2 class="text-2xl font-semibold text-white mb-2">
              <%= link_to post.title, blog_post_path(post.slug), class: "hover:text-purple-400 transition-colors" %>
            </h2>
            <% if post.excerpt.present? %>
              <p class="text-gray-300 mb-4"><%= post.excerpt %></p>
            <% end %>
            <div class="flex items-center justify-between">
              <p class="text-sm text-gray-400">
                <%= post.published_at&.strftime("%d de %B de %Y") || "Sem data" %>
              </p>
              <%= link_to "Ler mais →", blog_post_path(post.slug), class: "text-purple-400 hover:text-purple-300 transition-colors font-medium" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </main>

  <footer class="border-t border-white/10 bg-white/5 backdrop-blur-md py-8 mt-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center text-gray-400">
        <p>&copy; <%= Date.current.year %> Pedro Dalben. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>
</div>
