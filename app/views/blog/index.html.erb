<div class="min-h-screen theme-bg" data-controller="navigation">
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-white/5 backdrop-blur-md">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center">
          <%= link_to root_path, class: "text-xl font-bold text-white theme-accent-hover transition-colors cursor-pointer" do %>
            Pedro Dalben
          <% end %>
        </div>
        <div class="flex items-center gap-6">
          <a href="<%= root_path %>#sobre" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors">Sobre</a>
          <a href="<%= root_path %>#habilidades" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors">Habilidades</a>
          <a href="<%= root_path %>#mentoria" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors">Mentoria</a>
          <a href="<%= root_path %>#experiencia" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors">Experiência</a>
          <a href="<%= root_path %>#hobbies" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors">Hobbies</a>
          <a href="<%= root_path %>#portfolio" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors">Portfólio</a>
          <a href="<%= root_path %>#contato" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors">Contato</a>
          <div class="h-6 w-px bg-white/20"></div>
          <%= link_to "Blog", blog_path, class: "text-white font-semibold transition-colors" %>
          <% if user_signed_in? %>
            <%= link_to "Admin", admin_dashboard_path, class: "rounded-lg theme-gradient px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity" %>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <main class="pt-16">
    <section class="py-20 scroll-mt-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h1 class="text-4xl font-bold text-white mb-4">Blog</h1>
          <div class="h-1 w-24 theme-divider mx-auto"></div>
          <p class="text-gray-300 mt-6 text-lg">Artigos sobre desenvolvimento, tecnologia e carreira</p>
        </div>

        <div class="max-w-4xl mx-auto">
          <div class="space-y-6">
            <% @posts.each do |post| %>
              <article class="rounded-xl bg-white/10 backdrop-blur-md border border-white/20 theme-hover-border transition-all">
                <div class="p-6">
                  <h2 class="text-2xl font-semibold text-white mb-2">
                    <%= link_to post.title, blog_post_path(post.slug), class: "theme-accent-hover transition-colors" %>
                  </h2>
                  <% if post.excerpt.present? %>
                    <p class="text-gray-300 mb-4"><%= post.excerpt %></p>
                  <% end %>
                  <div class="flex items-center justify-between">
                    <p class="text-sm text-gray-400">
                      <%= post.published_at&.strftime("%d de %B de %Y") || "Sem data" %>
                    </p>
                    <%= link_to "Ler mais →", blog_post_path(post.slug), class: "theme-accent hover:opacity-80 transition-colors font-medium" %>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 bg-white/5 backdrop-blur-md py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <div>
          <h3 class="text-white font-semibold mb-4">Navegação</h3>
          <ul class="space-y-2 text-gray-400">
            <li><a href="<%= root_path %>#sobre" class="hover:text-white transition-colors">Sobre</a></li>
            <li><a href="<%= root_path %>#habilidades" class="hover:text-white transition-colors">Habilidades</a></li>
            <li><a href="<%= root_path %>#portfolio" class="hover:text-white transition-colors">Portfólio</a></li>
            <li><a href="<%= root_path %>#contato" class="hover:text-white transition-colors">Contato</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-4">Blog</h3>
          <p class="text-gray-400 mb-4">Artigos sobre desenvolvimento, tecnologia e carreira</p>
          <%= link_to "Ver todos os posts", blog_path, class: "theme-accent hover:opacity-80 transition-colors inline-flex items-center gap-2" %>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-4">Contato</h3>
          <ul class="space-y-2 text-gray-400">
            <li>
              <a href="mailto:pedrodalbenmorais@gmail.com" class="hover:text-white transition-colors inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                E-mail
              </a>
            </li>
            <li>
              <%= link_to "https://www.linkedin.com/in/pedrodalbendemorais", target: "_blank", rel: "noopener noreferrer", class: "hover:text-white transition-colors inline-flex items-center gap-2" do %>
                <%= social_icon("linkedin") %>
                LinkedIn
              <% end %>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10 pt-8 text-center text-gray-400">
        <p>&copy; <%= Date.current.year %> Pedro Dalben. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>
</div>
