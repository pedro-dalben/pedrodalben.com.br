          <div class="h-1 w-24 theme-divider mx-auto"></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-4 sm:space-y-6">
          <% [
            { role: "CTO", company: "Integrar Centro Terapeutico da Baixa Mogiana", period: "junho/2025", description: "Liderança técnica e desenvolvimento do sistema Integrar Plus" },
            { role: "Desenvolvedor Full Stack", company: "Appolus Tecnologia", period: "junho/2024 a junho/2025", tech: "Vue.js/Rails" },
            { role: "Líder Técnico", company: "Kazap Tecnologia", period: "jun/2022 a junho/2024" },
            { role: "Desenvolvedor Full Stack", company: "Kazap Tecnologia", period: "out/2019 a jun/2022", tech: "Vue.js/Rails" },
            { role: "Estagiário de Programação", company: "Phi Innovation", period: "set/2018 a fev/2019", tech: "Python, SQL, C, C++" }
          ].each do |exp| %>
            <div class="rounded-xl bg-white/10 backdrop-blur-md p-4 sm:p-6 border border-white/20 theme-hover-border transition-all">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                <div class="flex-1">
                  <h3 class="text-lg sm:text-xl font-bold text-white mb-1"><%= exp[:role] %></h3>
                  <p class="theme-text-light font-medium text-sm sm:text-base"><%= exp[:company] %></p>
                </div>
                <span class="text-gray-300 text-xs sm:text-sm md:text-base shrink-0"><%= exp[:period] %></span>
              </div>
              <% if exp[:tech] %>
                <p class="text-gray-400 text-xs sm:text-sm mt-2">Tecnologias: <%= exp[:tech] %></p>
              <% end %>
              <% if exp[:description] %>
                <p class="text-gray-300 mt-2 text-sm sm:text-base leading-relaxed"><%= exp[:description] %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </section>

