    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center">
          <a href="#inicio" class="text-xl font-bold text-white theme-accent-hover transition-colors cursor-pointer">Pedro Dalben</a>
        </div>
        <div class="flex items-center gap-6">
          <a href="#sobre" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors theme-focus-ring">Sobre</a>
          <a href="#habilidades" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors theme-focus-ring">Habilidades</a>
          <a href="#mentoria" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors theme-focus-ring">Mentoria</a>
          <a href="#experiencia" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors theme-focus-ring">Experiência</a>
          <a href="#hobbies" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors theme-focus-ring">Hobbies</a>
          <a href="#portfolio" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors theme-focus-ring">Portfólio</a>
          <a href="#contato" data-navigation-target="link" class="text-gray-300 hover:text-white transition-colors theme-focus-ring">Contato</a>
          <div class="h-6 w-px bg-white/20"></div>
          <%= link_to "Blog", blog_path, class: "text-gray-300 hover:text-white transition-colors" %>
          <% if user_signed_in? %>
            <%= link_to "Admin", admin_dashboard_path, class: "rounded-lg theme-gradient px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity" %>
          <% end %>
        </div>
      </div>
