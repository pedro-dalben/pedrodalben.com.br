              <a href="https://discord.gg/wjpKU7zZrR" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg theme-gradient px-3 sm:px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-all theme-focus-ring">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                </svg>
                Discord
              </a>
            </div>
          </div>

          <div class="rounded-xl bg-white/10 backdrop-blur-md p-4 sm:p-6 border border-white/20 theme-hover-border transition-all hover:scale-105">
            <div class="mb-4">
              <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">Conto do Pescador</h3>
              <p class="theme-text-light text-sm mb-4">Loja de Pesca e Lifestyle Outdoor</p>
            </div>
            <p class="text-gray-300 leading-relaxed mb-4 text-sm sm:text-base">
              Nasceu da minha paixão por pescarias, natureza e atividades ao ar livre. Mais do que vender equipamentos, representa um <strong class="text-white">estilo de vida</strong> — para quem acredita que as melhores ideias e lembranças nascem quando estamos em contato com o mundo lá fora.
            </p>
            <div class="flex gap-2">
              <a href="https://www.instagram.com/ocontodopescador/?hl=af" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg theme-gradient px-3 sm:px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-all theme-focus-ring">
                <%= social_icon("instagram") %>
                Instagram
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <% if @featured_projects.any? %>
      <section id="portfolio" data-navigation-target="section" class="py-20 scroll-mt-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-white mb-4">Projetos em Destaque</h2>
            <div class="h-1 w-24 theme-divider mx-auto"></div>
          </div>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            <% @featured_projects.each do |project| %>
              <div class="group rounded-xl bg-white/10 backdrop-blur-md overflow-hidden border border-white/20 theme-hover-border transition-all hover:scale-105 h-full flex flex-col">
                <% if project.image_url.present? %>
                  <img src="<%= project.image_url %>" alt="Captura de tela do projeto <%= project.title %>" class="h-48 w-full object-cover">
                <% else %>
                  <div class="h-48 w-full bg-linear-to-br from-theme-accent/20 to-theme-accent/10 flex items-center justify-center">
                    <svg class="w-16 h-16 text-theme-accent/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                  </div>
                <% end %>
                <div class="p-6 flex-1 flex flex-col">
                  <h3 class="text-xl font-semibold text-white mb-2"><%= project.title %></h3>
                  <p class="text-gray-300 line-clamp-3 mb-6 flex-1"><%= project.description %></p>
                  <div class="flex flex-wrap gap-3 mt-auto">
                    <% if project.url.present? %>
                      <%= link_to "Ver Projeto", project.url, target: "_blank", class: "inline-flex items-center gap-2 rounded-lg theme-gradient px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-all theme-focus-ring" %>
                    <% end %>
                    <% if project.github_url.present? %>
                      <%= link_to project.github_url, target: "_blank", class: "inline-flex items-center gap-2 rounded-lg border border-white/20 px-4 py-2 text-sm font-medium text-white hover:bg-white/10 transition-all theme-focus-ring" do %>
                        <%= social_icon("github") %>
                        GitHub
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <% if @recent_posts.any? %>
      <section class="py-20 bg-white/5 backdrop-blur-sm">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-white mb-4">Últimos Posts</h2>
            <div class="h-1 w-24 theme-divider mx-auto"></div>
          </div>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            <% @recent_posts.each do |post| %>
              <div class="rounded-xl bg-white/10 backdrop-blur-md p-6 border border-white/20 theme-hover-border transition-all">
                <h3 class="text-xl font-semibold text-white mb-2">
                  <%= link_to post.title, blog_post_path(post.slug), class: "theme-accent-hover transition-colors" %>
                </h3>
                <% if post.excerpt.present? %>
                  <p class="text-gray-300 mb-4"><%= post.excerpt %></p>
                <% end %>
                <p class="text-sm text-gray-400">
                  <%= post.published_at&.strftime("%d/%m/%Y") %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <section id="contato" data-navigation-target="section" class="py-20 scroll-mt-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <div class="rounded-2xl theme-gradient p-8 sm:p-12 text-center lg:text-left">
            <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Vamos trabalhar juntos?</h2>
            <p class="text-lg sm:text-xl text-white/90 mb-8">Estou sempre aberto a novos projetos e oportunidades</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <%= link_to "https://www.linkedin.com/in/pedrodalbendemorais", target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-2 rounded-lg bg-white/10 backdrop-blur-sm border border-white/20 px-6 py-3 text-white font-semibold hover:bg-white/20 transition-all theme-focus-ring" do %>
                <%= social_icon("linkedin") %>
                LinkedIn
              <% end %>
              <a href="mailto:pedrodalbenmorais@gmail.com" class="inline-flex items-center gap-2 rounded-lg bg-white/10 backdrop-blur-sm border border-white/20 px-6 py-3 text-white font-semibold hover:bg-white/20 transition-all theme-focus-ring">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                E-mail
              </a>
            </div>
          </div>

          <div class="rounded-2xl bg-white/10 backdrop-blur-md p-8 border border-white/20">
            <h3 class="text-2xl font-bold text-white mb-6 text-center">Envie uma mensagem</h3>
            <%= form_with url: contact_path, method: :post, class: "space-y-6" do |f| %>
              <div>
                <%= f.label :name, "Nome", class: "block text-sm font-medium text-white mb-2" %>
                <%= f.text_field :name, required: true, class: "w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent theme-focus-ring", placeholder: "Seu nome" %>
              </div>

              <div>
                <%= f.label :email, "E-mail", class: "block text-sm font-medium text-white mb-2" %>
                <%= f.email_field :email, required: true, class: "w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent theme-focus-ring", placeholder: "seu@email.com" %>
              </div>

              <div>
                <%= f.label :message, "Mensagem", class: "block text-sm font-medium text-white mb-2" %>
                <%= f.text_area :message, required: true, rows: 5, class: "w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent theme-focus-ring resize-none", placeholder: "Conte-me sobre seu projeto..." %>
              </div>

              <div class="text-center">
                <%= f.submit "Enviar Mensagem", class: "inline-flex items-center gap-2 rounded-lg theme-gradient px-8 py-3 text-white font-semibold hover:opacity-90 transition-all theme-shadow theme-focus-ring" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 bg-white/5 backdrop-blur-md py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <div>
          <h3 class="text-white font-semibold mb-4">Navegação</h3>
          <ul class="space-y-2 text-gray-400">
            <li><a href="#sobre" class="hover:text-white transition-colors">Sobre</a></li>
            <li><a href="#habilidades" class="hover:text-white transition-colors">Habilidades</a></li>
            <li><a href="#portfolio" class="hover:text-white transition-colors">Portfólio</a></li>
            <li><a href="#contato" class="hover:text-white transition-colors">Contato</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-4">Blog</h3>
          <p class="text-gray-400 mb-4">Artigos sobre desenvolvimento, tecnologia e carreira</p>
          <%= link_to "Ver todos os posts", blog_path, class: "theme-accent hover:opacity-80 transition-colors inline-flex items-center gap-2" %>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-4">Contato</h3>
          <ul class="space-y-2 text-gray-400">
            <li>
              <a href="mailto:pedrodalbenmorais@gmail.com" class="hover:text-white transition-colors inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                E-mail
              </a>
            </li>
            <li>
              <%= link_to "https://www.linkedin.com/in/pedrodalbendemorais", target: "_blank", rel: "noopener noreferrer", class: "hover:text-white transition-colors inline-flex items-center gap-2" do %>
                <%= social_icon("linkedin") %>
                LinkedIn
              <% end %>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10 pt-8 text-center text-gray-400">
        <p>&copy; <%= Date.current.year %> Pedro Dalben. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>
</div>
