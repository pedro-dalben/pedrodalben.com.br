<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Alterar senha</h2>
  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Digite sua nova senha</p>
</div>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div>
    <%= f.label :password, "Nova Senha", class: "mb-2 block text-sm font-medium text-gray-900 dark:text-white" %>
    <% if @minimum_password_length %>
      <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">(<%= @minimum_password_length %> caracteres no mínimo)</p>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder:text-gray-500 dark:focus:border-blue-500" %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirmar Nova Senha", class: "mb-2 block text-sm font-medium text-gray-900 dark:text-white" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder:text-gray-500 dark:focus:border-blue-500" %>
  </div>

  <div>
    <%= f.submit "Alterar senha", class: "w-full rounded-lg bg-blue-600 px-4 py-3 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900" %>
  </div>
<% end %>

<div class="mt-6 text-center">
  <%= render "devise/shared/links" %>
</div>
