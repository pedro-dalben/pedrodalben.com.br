<!DOCTYPE html>
<html lang="pt-BR" x-data="{ darkMode: false }" x-init="darkMode = JSON.parse(localStorage.getItem('darkMode') || 'false')" :class="{'dark bg-gray-900': darkMode === true}">
  <head>
    <title><%= content_for(:title) || "Autenticação - Pedro Dalben" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "application.css" %>
    <%= vite_javascript_tag 'application' %>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900">
    <div class="flex min-h-screen items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
      <div class="w-full max-w-md">
        <div class="mb-8 text-center">
          <%= link_to root_path, class: "inline-block" do %>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Pedro Dalben</h1>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Painel Administrativo</p>
          <% end %>
        </div>

        <div class="rounded-lg border border-gray-200 bg-white p-8 shadow-lg dark:border-gray-800 dark:bg-gray-900">
          <% if notice %>
            <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 dark:bg-green-900/20 dark:text-green-400">
              <%= notice %>
            </div>
          <% end %>

          <% if alert %>
            <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-400">
              <%= alert %>
            </div>
          <% end %>

          <%= yield %>
        </div>

        <div class="mt-6 text-center">
          <button
            @click="darkMode = !darkMode; localStorage.setItem('darkMode', JSON.stringify(darkMode))"
            class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800"
          >
            <svg x-show="!darkMode" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
            <svg x-show="darkMode" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <span x-text="darkMode ? 'Modo Claro' : 'Modo Escuro'"></span>
          </button>
        </div>
      </div>
    </div>
  </body>
</html>

