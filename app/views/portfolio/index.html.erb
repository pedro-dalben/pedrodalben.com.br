<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
  <nav class="border-b border-white/10 bg-white/5 backdrop-blur-md">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <%= link_to root_path, class: "flex items-center" do %>
          <span class="text-xl font-bold text-white">Pedro Dalben</span>
        <% end %>
        <div class="flex items-center gap-6">
          <%= link_to "Portfólio", portfolio_path, class: "text-white font-medium" %>
          <%= link_to "Blog", blog_path, class: "text-gray-300 hover:text-white transition-colors" %>
        </div>
      </div>
    </div>
  </nav>

  <main class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold text-white mb-4">Portfólio</h1>
      <div class="h-1 w-24 bg-gradient-to-r from-purple-500 to-pink-500 mx-auto"></div>
      <p class="text-gray-300 mt-6 text-lg">Alguns dos projetos que desenvolvi ao longo da minha carreira</p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      <% @projects.each do |project| %>
        <div class="group rounded-xl bg-white/10 backdrop-blur-md overflow-hidden border border-white/20 hover:border-purple-500/50 transition-all hover:scale-105">
          <% if project.image_url.present? %>
            <img src="<%= project.image_url %>" alt="<%= project.title %>" class="h-48 w-full object-cover">
          <% end %>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-white mb-2">
              <%= link_to project.title, portfolio_project_path(project), class: "hover:text-purple-400 transition-colors" %>
            </h3>
            <p class="text-gray-300 line-clamp-3 mb-4"><%= project.description %></p>
            <div class="flex gap-2">
              <% if project.url.present? %>
                <%= link_to "Ver Projeto", project.url, target: "_blank", rel: "noopener noreferrer", class: "rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 px-4 py-2 text-sm font-medium text-white hover:from-purple-700 hover:to-pink-700 transition-all" %>
              <% end %>
              <% if project.github_url.present? %>
                <%= link_to "GitHub", project.github_url, target: "_blank", rel: "noopener noreferrer", class: "rounded-lg border border-white/20 px-4 py-2 text-sm font-medium text-white hover:bg-white/10 transition-all" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </main>

  <footer class="border-t border-white/10 bg-white/5 backdrop-blur-md py-8 mt-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center text-gray-400">
        <p>&copy; <%= Date.current.year %> Pedro Dalben. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>
</div>
