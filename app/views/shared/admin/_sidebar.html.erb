<aside
  :class="sidebarToggle ? 'translate-x-0 xl:w-[90px]' : '-translate-x-full'"
  class="sidebar fixed top-0 left-0 z-9999 flex h-screen w-[290px] flex-col overflow-y-auto border-r border-gray-200 bg-white px-5 transition-all duration-300 xl:static xl:translate-x-0 dark:border-gray-800 dark:bg-black"
  @click.outside="sidebarToggle = false"
>
  <div
    :class="sidebarToggle ? 'justify-center' : 'justify-between'"
    class="sidebar-header flex items-center gap-2 pt-8 pb-7"
  >
    <%= link_to admin_dashboard_path, class: "flex items-center" do %>
      <span class="logo" :class="sidebarToggle ? 'hidden' : ''">
        <span class="text-xl font-bold text-gray-900 dark:text-white">Pedro Dalben</span>
      </span>
      <span
        class="logo-icon text-xl font-bold"
        :class="sidebarToggle ? 'xl:block' : 'hidden'"
      >
        PD
      </span>
    <% end %>
  </div>

  <div class="no-scrollbar flex flex-col overflow-y-auto duration-300 ease-linear">
    <nav>
      <div>
        <h3 class="mb-4 text-xs leading-[20px] text-gray-400 uppercase">
          <span class="menu-group-title" :class="sidebarToggle ? 'xl:hidden' : ''">
            MENU
          </span>
        </h3>

        <ul class="mb-6 flex flex-col gap-1">
          <li>
            <%= link_to admin_dashboard_path, class: "menu-item group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{request.path == admin_dashboard_path ? 'bg-gray-100 text-gray-900 dark:bg-gray-800 dark:text-white' : 'text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800'}" do %>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span :class="sidebarToggle ? 'xl:hidden' : ''">Dashboard</span>
            <% end %>
          </li>

          <li>
            <%= link_to admin_projects_path, class: "menu-item group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{request.path.include?('projects') ? 'bg-gray-100 text-gray-900 dark:bg-gray-800 dark:text-white' : 'text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800'}" do %>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span :class="sidebarToggle ? 'xl:hidden' : ''">Projetos</span>
            <% end %>
          </li>

          <li>
            <%= link_to admin_posts_path, class: "menu-item group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{request.path.include?('posts') ? 'bg-gray-100 text-gray-900 dark:bg-gray-800 dark:text-white' : 'text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800'}" do %>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span :class="sidebarToggle ? 'xl:hidden' : ''">Posts</span>
            <% end %>
          </li>

          <li>
            <%= link_to admin_clients_path, class: "menu-item group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{request.path.include?('clients') ? 'bg-gray-100 text-gray-900 dark:bg-gray-800 dark:text-white' : 'text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800'}" do %>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <span :class="sidebarToggle ? 'xl:hidden' : ''">Clientes</span>
            <% end %>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</aside>



