<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Clientes</h1>
  <%= link_to "Novo Cliente", new_admin_client_path, class: "rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white hover:bg-purple-700" %>
</div>

<div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
  <table class="w-full">
    <thead class="bg-gray-50 dark:bg-gray-800">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Nome</th>
        <th class="px-6 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Empresa</th>
        <th class="px-6 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Email</th>
        <th class="px-6 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Ações</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
      <% @clients.each do |client| %>
        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800">
          <td class="px-6 py-4 text-sm font-medium text-gray-900 dark:text-white"><%= client.name %></td>
          <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= client.company_name || '-' %></td>
          <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= client.email || '-' %></td>
          <td class="px-6 py-4 text-sm">
            <%= link_to "Editar", edit_admin_client_path(client), class: "text-blue-600 hover:text-blue-900 dark:text-blue-400" %>
            <%= link_to "Excluir", admin_client_path(client), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "ml-4 text-red-600 hover:text-red-900 dark:text-red-400" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

