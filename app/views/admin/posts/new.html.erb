<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Novo Post</h1>
</div>

<%= form_with model: [:admin, @post], class: "space-y-6 rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900" do |f| %>
  <% if @post.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-red-800 dark:bg-red-900/20 dark:text-red-400">
      <ul>
        <% @post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Título", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-green-500 focus:outline-none focus:ring-green-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" %>
  </div>

  <div>
    <%= f.label :slug, "Slug", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= f.text_field :slug, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-green-500 focus:outline-none focus:ring-green-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" %>
    <p class="mt-1 text-xs text-gray-500">Deixe em branco para gerar automaticamente</p>
  </div>

  <div>
    <%= f.label :excerpt, "Resumo", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= f.text_area :excerpt, rows: 3, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-green-500 focus:outline-none focus:ring-green-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" %>
  </div>

  <div data-controller="markdown-editor" data-markdown-editor-upload-url-value="<%= admin_images_path %>">
    <%= f.label :content, "Conteúdo (Markdown)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
    <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">Use Markdown para formatar o texto. Você pode arrastar imagens diretamente no editor.</p>
    <%= f.text_area :content, id: "post_content_#{Time.current.to_i}", rows: 10, data: { "markdown-editor-target": "textarea" }, class: "mt-1 block w-full" %>
  </div>

  <div>
    <%= f.label :featured_image_url, "URL da Imagem", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= f.text_field :featured_image_url, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-green-500 focus:outline-none focus:ring-green-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" %>
  </div>

  <div class="flex items-center gap-4">
    <div class="flex items-center">
      <%= f.check_box :published, class: "h-4 w-4 rounded border-gray-300 text-green-600 focus:ring-green-500" %>
      <%= f.label :published, "Publicado", class: "ml-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>
    </div>
  </div>

  <div class="flex gap-4">
    <%= f.submit "Criar Post", class: "rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700" %>
    <%= link_to "Cancelar", admin_posts_path, class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800" %>
  </div>
<% end %>




